# BRC MCP Server configuration
BRC_API_BASE_URL=https://app.bigredcloud.com/api
PORT=3000

# MCP session binding lifetime (minutes)
BRC_MCP_SESSION_TTL_MINUTES=120
# How long a stored company API key stays valid in MCP memory (stdio and HTTP).
# Also drives user-facing duration wording on the connection page and in assistant guidance.
BRC_API_KEY_TTL_MINUTES=120
# IANA timezone for connection expiry wording shown to users (e.g. Europe/Dublin for IST).
BRC_DISPLAY_TIMEZONE=Europe/Dublin

# Server rate limiting
# Default: 100 requests per minute per IP address
BRC_RATE_LIMIT_REQUESTS_PER_MINUTE=300

# Skill visibility and permissions
# If false, matching tools should not appear in Cursor/Claude and should not be accepted.
BRC_ALLOW_READ_SKILLS=true
BRC_ALLOW_UPDATE_SKILLS=true
BRC_ALLOW_DELETE_SKILLS=true
BRC_ALLOW_EMAIL_SKILLS=true
BRC_ALLOW_BATCH_SKILLS=true
# Dev mode exposes operator-only deployment diagnostics (brc_get_dev_mode_details). Default off for customer deployments.
BRC_ALLOW_DEV_MODE=false

# Operational limits (default 5; server caps at 10)
BRC_MAX_BATCH_ITEMS=5
BRC_MAX_AUDIT_ENTRIES=500

# API key blacklist
# Store SHA-256 hashes of blocked API keys, comma separated.
# Do not store raw API keys here.
BRC_API_KEY_BLACKLIST_SHA256=

# Public URL for the Red /connect page (hosted deployments)
# Must point at the same App Service slot that owns this process's connection store.
# Staging should use the staging hostname, not production red.bigredcloud.com.
BRC_PUBLIC_BASE_URL=https://brc-live-mcp.azurewebsites.net
# Optional override used only for /connect links (wins over BRC_PUBLIC_BASE_URL)
# BRC_CONNECT_PUBLIC_BASE_URL=https://brc-live-mcp-app-staging.azurewebsites.net

# Red connection persistence
# memory = local/Cursor in-process fallback
# cosmos = shared Cosmos DB persistence for hosted ChatGPT and multi-instance deployments
# Staging and production slots must either share one Cosmos db/container OR each must
# generate /connect URLs that hit their own slot (see getPublicBaseUrl slot handling).
RED_CONNECT_CONNECTION_STORE=memory
RED_CONNECT_COSMOS_CONNECTION_STRING=
RED_CONNECT_COSMOS_DATABASE=red-connect
RED_CONNECT_COSMOS_CONTAINER=connections
# Recommended when RED_CONNECT_CONNECTION_STORE=cosmos (encrypts API keys at rest)
RED_CONNECT_ENCRYPTION_KEY=

# Set automatically when running the HTTP MCP server (remote.ts)
RED_CONNECT_HTTP_MODE=true
# Optional: log per-company credential validation results (no API keys in logs)
# RED_CONNECT_CREDENTIAL_VALIDATION_DEBUG=true

# BRC Edu CSV paths (local OneDrive sync folder for dev; repo data/ defaults when unset)
# SharePoint web links are for humans only. Red and local dev use synced local file paths.
# BRC_EDU_SUPPORT_CSV_PATH=data/webinar_video_routing_index.csv
# BRC_EDU_ENRICHED_CSV_PATH=data/dev_only_video_routing_index_updated.csv

# BRC Edu source: local reads generated CSV; graph reads support CSV from OneDrive/SharePoint
BRC_EDU_SOURCE=local
BRC_EDU_CACHE_TTL_MINUTES=5
BRC_EDU_GRAPH_TENANT_ID=
BRC_EDU_GRAPH_CLIENT_ID=
BRC_EDU_GRAPH_CLIENT_SECRET=
BRC_EDU_GRAPH_DRIVE_ID=
BRC_EDU_GRAPH_ITEM_ID=

# BRC Edu push sync (Power Automate / internal automation)
# BRC_EDU_SYNC_SECRET=
# BRC_EDU_SYNCED_RESOURCES_PATH=data/brc_edu_synced_resources.json

# BRC Edu admin upload (internal browser upload to Azure Blob Storage)
# Primary access: Azure App Service Authentication / Microsoft Entra ID
# BRC_EDU_ADMIN_ENTRA_TENANT_ID=
# BRC_EDU_ADMIN_ENTRA_GROUP_ID=
# BRC_EDU_ADMIN_ENTRA_APP_ROLE=
# BRC_EDU_ADMIN_PROTECTED_PATH=/internal/brc-edu/resources/upload
# BRC_EDU_ADMIN_PUBLIC_URL=https://your-red-host.azurewebsites.net/internal/brc-edu/resources/upload
# Emergency secret fallback only (do not share with Red/MCP; disable after Entra is verified):
# BRC_EDU_ADMIN_UPLOAD_SECRET=
# BRC_EDU_ADMIN_ALLOW_SECRET_FALLBACK=true
# BRC_EDU_UPLOAD_STORAGE_CONNECTION_STRING=
# BRC_EDU_UPLOAD_CONTAINER=
